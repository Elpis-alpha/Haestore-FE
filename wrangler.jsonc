{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heastore-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  // nodejs_compat is required by the OpenNext adapter for Node-runtime server
  // components. global_fetch_strictly_public makes fetches to our own domain go
  // through the public internet rather than looping back into the Worker.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
}
