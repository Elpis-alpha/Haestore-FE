# Hæstore storefront — values for a deployment build. See docs/DEPLOYMENT.md.
#
# These are read by `npm run cf:build` and baked into the Worker, so export them in the
# shell that runs the build. Changing one means rebuilding, not redeploying.

# BOTH build time and runtime: the /api rewrite is fixed at build, and server components
# read it at runtime from wrangler.jsonc "vars". Set it in both places, to the same value.
API_ORIGIN=https://api.example.com

NEXT_PUBLIC_SITE_URL=https://shop.example.com
# Without it a photograph uploaded in the console renders broken. Seeded Unsplash
# photographs do not need it.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Test mode only. A pk_live_ key fails the build (ADR-016).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# A PayPal sandbox app's client id.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Runtime secret, NOT a build value — never put it in a file that is committed:
#   npx wrangler secret put PROXY_SHARED_SECRET
# The same value as the API's PROXY_SHARED_SECRET.
