# Hæstore storefront environment (local development).
# Public values only — anything NEXT_PUBLIC_* is shipped to the browser.
# See .env.backup-2022 for the original CRA file.

# Server-side only: where next.config.ts proxies /api/* to.
API_ORIGIN=http://127.0.0.1:5000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Publishable/client ids. Safe to expose; the secret halves live in back-end/.env.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
